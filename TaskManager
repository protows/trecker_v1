package trecker.v1;

import java.util.HashMap;
import java.util.ArrayList;

public class TaskManager {
    private HashMap<Integer, Task> tasks;
    private HashMap<Integer, Epic> epics;
    private HashMap<Integer, Subtask> subtasks;
    private int generatorId=1;
    
    public TaskManager() {
        tasks = new HashMap<>();
        epics = new HashMap<>();
        subtasks = new HashMap<>();
    }
    
    // --- Методы для обычных задач ---
    public ArrayList<Task> getAllTasks() { 
        return new ArrayList<>(tasks.values());
     }
    public void deleteAllTasks() {
        tasks.clear();
    }
    public Task getTaskById(int id) { 
       return tasks.get(id);

    } 
    public void createTask(Task task) {
        int id = generatorId++;
        if(tasks.containsKey(id)){
            return;
        }
        task.setTaskid(id);
        tasks.put(id, task);   
    }
    public void updateTask(Task task) {
        int id = task.getTaskid();
        if (tasks.containsKey(id)) {
            tasks.put(id, task);
        }
    }
    public void deleteTaskById(int id) {
        if (tasks.containsKey(id)) {
        tasks.remove(id);
        }
    }
    
    // --- Методы для эпиков ---
    public void removeAllEpics(){
        epics.clear();
    }
    public ArrayList<Epic> getAllEpics(){
         return new ArrayList<>(epics.values()); 
     }
    
    public Epic getEpicById(int id){
        return epics.get(id);
    }
     
   public void updateEpic(Epic epic){
        int id = epic.getTaskid();
        if (epics.containsKey(id)) {
            epics.put(id, epic);
        }
   }
   public void removeEpicById(int id){
       epics.remove(id);
   }
   
   public void createEpic(Epic epic) {
    int id = generatorId++;
    if(epics.containsKey(id)){
        return;
    }
    epic.setTaskid(id);
    epics.put(id, epic);
   }
    
    ////////// Epic - subtaskIds
     public void  addSubtaskId(Integer subTaskid, Integer epicid){
        epics.get(epicid).getAllIdsSubsTaksOfEpic().add(subTaskid);
    } 
    public void  removeSubtaskId(Integer epicid, Integer id){
        epics.get(epicid).getAllIdsSubsTaksOfEpic().remove(id);
    } 
     public void clearSubtaskIds(Integer epicid){
         Epic epic = epics.get(epicid);
         if(epic!=null){
              epics.get(epicid).getAllIdsSubsTaksOfEpic().clear();
         }
        
    }
    /////////

    // --- Методы для подзадач -------------------
    public ArrayList<Subtask> getAllSubtasks( ) { 
       
        if(subtasks !=null){
            return new ArrayList<>(subtasks.values());
        }else{
            return new ArrayList<>();
        }
        
    }
    public void deleteAllSubtasks() {
        for(Epic epic2: epics.values()){
             epic2.getAllIdsSubsTaksOfEpic().clear();
             updateEpicStatus(epic2);
        }
        subtasks.clear();
    }
       
    public Subtask getSubtaskById(int id) { 
        return subtasks.get(id);
    }
    public void createSubtask(Subtask subtask) {
        int id = generatorId++; // Генерируем уникальный ID
        if (subtasks.containsKey(id)) {
            return;
        }
        subtask.setTaskid(id);
        subtasks.put(id, subtask);
        addSubtaskId(id, subtask.getEpicId());
    }
    public void updateSubtask(Subtask subTaskItem) {
        int id = subTaskItem.getTaskid();
        subtasks.put(id, subTaskItem);
        Epic epic = new Epic(subTaskItem.getName(), subTaskItem.getDescription(), subTaskItem.getStatus());
        updateEpicStatus(epic);
    }
    public void deleteSubtaskById(Subtask subTaskItem) {
        removeSubtaskId(subTaskItem.getTaskid(), subTaskItem.getEpicId());
        Epic epic2 = epics.get(subTaskItem.getEpicId());
        updateEpicStatus(epic2);
        subtasks.remove(subTaskItem.getTaskid());
    }
    
    public ArrayList<Subtask> getSubtasksOfEpic(int epicId) { 
         Epic epic = epics.get(epicId);
        if (epic == null) {
            return new ArrayList<>();
        } 
        ArrayList<Subtask> result = new ArrayList<>();
        for (Integer subtaskId : epic.getAllIdsSubsTaksOfEpic()) {
            Subtask subtask = subtasks.get(subtaskId);
            if (subtask != null) {
                result.add(subtask);
            }
        }
        return result;
    }
    
    private void updateEpicStatus(Epic epic) {
    ArrayList<Integer> subtaskIds = epic.getAllIdsSubsTaksOfEpic();
        if (subtaskIds.isEmpty()) {
        epic.setStatus(TaskStatus.NEW);
        return;
    } 
    boolean allNew = true;
    boolean allDone = true;
    for (int id : subtaskIds) {
        Subtask subtask = subtasks.get(id);
        if (subtask != null) {
            TaskStatus status = subtask.getStatus();
            
            if (status != TaskStatus.NEW) {
                allNew = false;
            }
            if (status != TaskStatus.DONE) {
                allDone = false;
            }
        }
    }

    if (allNew) {
        epic.setStatus(TaskStatus.NEW);
    } else if (allDone) {
        epic.setStatus(TaskStatus.DONE);
    } else {
        epic.setStatus(TaskStatus.IN_PROGRESS);
    }
}

    public int getCurrentGeneratorId(){
        return generatorId;
    }
      
    
}
